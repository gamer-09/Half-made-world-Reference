# --- AI backend (optional) -------------------------------------------------
# The server talks to any OpenAI-compatible chat-completions endpoint.
# Groq is the default, so the only required value is an API key.
GROQ_API_KEY=your-groq-api-key

# Point the planner/explorer at a different provider instead.
# Local model via Ollama (no rate limits, runs offline):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=ollama
#
# OpenRouter (free models, no Groq token cap):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_API_KEY=your-openrouter-key
# AI_FALLBACK_MODELS=cohere/north-mini-code:free,minimax/minimax-m3.1-flash:free
#
# Local opencode CLI (uses whatever model/auth opencode is configured with —
# no API key needed here). The planner shells out to `opencode run`.
# Note: opencode's free Zen tier is only usable from inside the interactive app,
# so headless calls may 403; the server then falls back to the HTTP backend above.
# AI_PROVIDER=opencode
# OPENCODE_MODEL=opencode/big-pickle   # provider/model; blank = opencode's default
# OPENCODE_BIN=opencode                # path to the binary if not on PATH
# OPENCODE_FALLBACK=true               # fall back to HTTP if opencode fails
#
# Advanced toggles (both default to on):
# AI_REASONING=true     # send reasoning_effort (Groq/gpt-oss only)
# AI_JSON_MODE=false    # disable response_format JSON mode
# AI_FALLBACK_MODELS=   # OpenRouter only: extra models to try if the first is rate-limited
# AI_FULL_CONTEXT_BUDGET=700000  # char budget for the full-archive digest the planner reads (0 disables)
