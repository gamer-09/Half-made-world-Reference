# --- AI backends (optional) ------------------------------------------------
# The AI features use two SEPARATE, fixed backends:
#   • Explore / answer (Query Chat) → always the HTTP chat-completions endpoint
#     (Groq by default). Needs an API key.
#   • Planner (/api/ai/plan)        → always the local opencode CLI. Needs no
#     key, only an opencode binary (or OPENCODE_BIN).
# AI_PROVIDER no longer switches between them.

# --- HTTP backend (Explore / answer) ---------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Groq is the default, so the
# only required value is an API key.
GROQ_API_KEY=your-groq-api-key

# Point Explore at a different HTTP provider instead.
# Local model via Ollama (no rate limits, runs offline):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=ollama
#
# OpenRouter (free models, no Groq token cap):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_API_KEY=your-openrouter-key
# AI_FALLBACK_MODELS=cohere/north-mini-code:free,minimax/minimax-m3.1-flash:free

# --- Planner backend (opencode CLI only, no HTTP fallback) -----------------
# Uses whatever model/auth opencode is configured with — no API key needed.
# Note: opencode's free Zen tier is only usable from inside the interactive app,
# so headless calls may 403; the planner does NOT fall back to HTTP, so a failed
# opencode call fails the plan request.
# OPENCODE_MODEL=opencode/big-pickle   # provider/model; blank = opencode's default
# OPENCODE_BIN=opencode                # path to the binary if not on PATH
# OPENCODE_AGENT=plan                  # opencode agent the planner runs as
# OPENCODE_TIMEOUT_MS=480000           # how long one CLI call may take

# The Planning Room is switched OFF for now: the opencode run over the archive
# context is not dependable yet (it can run for minutes and then answer with
# prose instead of the requested JSON). Its implementation is untouched — set
# this to true to bring it back.
# AI_PLANNER_ENABLED=false

# --- Advanced toggles (both default to on) ---------------------------------
# AI_REASONING=true     # HTTP backend only: send reasoning_effort (Groq/gpt-oss only)
# AI_JSON_MODE=false    # HTTP backend only: disable response_format JSON mode
# AI_FALLBACK_MODELS=   # HTTP backend only: extra models to try if the first is rate-limited
# AI_FULL_CONTEXT_BUDGET=150000  # char budget for the full-archive digest the planner reads (0 disables)
